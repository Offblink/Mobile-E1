<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 任务 6：危险权限，运行时申请读系统通讯录 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 任务 6：跨 App 访问 ContactProvider 的 signature 权限（同签名自动授予） -->
    <uses-permission
        android:name="com.offblink.keyou.permission.READ_PROVIDER" />
    <permission
        android:name="com.offblink.keyou.permission.READ_PROVIDER"
        android:protectionLevel="signature" />
    <permission
        android:name="com.offblink.keyou.permission.WRITE_PROVIDER"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Keyou"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 任务 2 入口：登录页 -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".EditNicknameActivity" android:exported="false" />
        <activity android:name=".LabActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <activity android:name=".ContactListActivity" android:exported="false" />
        <activity android:name=".ContactEditActivity" android:exported="false" />
        <activity android:name=".ChatActivity" android:exported="false" />
        <activity android:name=".DraftActivity" android:exported="false" />
        <activity android:name=".JsonCompareActivity" android:exported="false" />
        <activity android:name=".RssParseActivity" android:exported="false" />

        <!-- 任务 2：四种启动模式对比（差异只在 launchMode） -->
        <activity
            android:name=".StandardLabActivity"
            android:exported="false"
            android:launchMode="standard" />
        <activity
            android:name=".SingleTopLabActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".SingleTaskLabActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".SingleInstanceLabActivity"
            android:exported="false"
            android:launchMode="singleInstance" />
        <!-- 任务 6：自定义 ContentProvider 共享 contact.db（读写权限拆分，signature 级） -->
        <provider
            android:name=".ContactProvider"
            android:authorities="com.offblink.keyou.provider.contact"
            android:exported="true"
            android:readPermission="com.offblink.keyou.permission.READ_PROVIDER"
            android:writePermission="com.offblink.keyou.permission.WRITE_PROVIDER" />

        <!-- 任务 4：静态注册的自定义广播接收器（8.0+ 只收 setPackage 显式广播） -->
        <receiver
            android:name=".SyncDoneReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.offblink.keyou.SYNC_DONE" />
            </intent-filter>
        </receiver>

        <!-- 任务 4：有序广播接收器对（priority 决定顺序，高者可 abortBroadcast 截断） -->
        <receiver
            android:name=".OrderedHighReceiver"
            android:exported="false">
            <intent-filter android:priority="100">
                <action android:name="com.offblink.keyou.ORDERED_DEMO" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".OrderedLowReceiver"
            android:exported="false">
            <intent-filter android:priority="0">
                <action android:name="com.offblink.keyou.ORDERED_DEMO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
