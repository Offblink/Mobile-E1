<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 网络请求 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务 + 定位 + 通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 跨 App 访问 ContactProvider 的 signature 权限（同签名自动授予） -->
    <uses-permission
        android:name="com.offblink.keyou.permission.READ_PROVIDER" />
    <permission
        android:name="com.offblink.keyou.permission.READ_PROVIDER"
        android:protectionLevel="signature" />
    <permission
        android:name="com.offblink.keyou.permission.WRITE_PROVIDER"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Keyou"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 入口：登录页 -->
        <activity
            android:name="com.offblink.keyou.ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.offblink.keyou.ui.MainActivity" android:exported="false" />
        <activity android:name="com.offblink.keyou.contacts.ContactDetailActivity" android:exported="false" />
        <activity android:name="com.offblink.keyou.log.LogActivity" android:exported="false" />
        <activity android:name="com.offblink.keyou.contacts.JsonCompareActivity" android:exported="false" />
        <activity android:name="com.offblink.keyou.chat.RssParseActivity" android:exported="false" />
        <activity android:name="com.offblink.keyou.download.DownloadActivity" android:exported="false" />
        <activity android:name="com.offblink.keyou.debug.ServiceActivity" android:exported="false" />
        <activity android:name="com.offblink.keyou.debug.DiagnosticsActivity" android:exported="false" />

        <!-- 前台服务下载（dataSync 类型）+ 绑定式便签服务 -->
        <service
            android:name="com.offblink.keyou.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="com.offblink.keyou.debug.BoundNoteService"
            android:exported="false" />

        <!-- 四种启动模式对比（差异只在 launchMode） -->
        <activity
            android:name="com.offblink.keyou.lab.StandardLabActivity"
            android:exported="false"
            android:launchMode="standard" />
        <activity
            android:name="com.offblink.keyou.lab.SingleTopLabActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name="com.offblink.keyou.lab.SingleTaskLabActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name="com.offblink.keyou.lab.SingleInstanceLabActivity"
            android:exported="false"
            android:launchMode="singleInstance" />
        <!-- 自定义 ContentProvider 共享 contact.db（读写权限拆分，signature 级） -->
        <provider
            android:name="com.offblink.keyou.provider.ContactProvider"
            android:authorities="com.offblink.keyou.provider.contact"
            android:exported="true"
            android:readPermission="com.offblink.keyou.permission.READ_PROVIDER"
            android:writePermission="com.offblink.keyou.permission.WRITE_PROVIDER" />

        <!-- 静态注册的自定义广播接收器（8.0+ 只收 setPackage 显式广播） -->
        <receiver
            android:name="com.offblink.keyou.lab.SyncDoneReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.offblink.keyou.SYNC_DONE" />
            </intent-filter>
        </receiver>

        <!-- 有序广播接收器对（priority 决定顺序，高者可 abortBroadcast 截断） -->
        <receiver
            android:name="com.offblink.keyou.lab.OrderedHighReceiver"
            android:exported="false">
            <intent-filter android:priority="100">
                <action android:name="com.offblink.keyou.ORDERED_DEMO" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.offblink.keyou.lab.OrderedLowReceiver"
            android:exported="false">
            <intent-filter android:priority="0">
                <action android:name="com.offblink.keyou.ORDERED_DEMO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
