<?xml version="1.0" encoding="utf-8"?>
<!-- 主页：m3 胶囊导航（nav-pill-bar 配方）—— 4 页面叠 FrameLayout + 底部弹射 pill -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 四个 Tab 页叠放（平移切页，非当前页 GONE） -->
    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            layout="@layout/page_contacts"
            android:id="@+id/page_contacts" />

        <include
            layout="@layout/page_chat"
            android:id="@+id/page_chat" />

        <include
            layout="@layout/page_mine"
            android:id="@+id/page_mine" />
    </FrameLayout>

    <!-- 网络变化横幅（叠在最上层，3 秒自动隐藏） -->
    <TextView
        android:id="@+id/tv_net_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:gravity="center"
        android:background="@color/md_secondary_container"
        android:textColor="@color/md_on_secondary_container"
        android:visibility="gone"
        android:layout_gravity="top" />

    <!-- 底部胶囊导航条（配方：76dp + 三边 12dp margin + elevation 8dp） -->
    <FrameLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="8dp"
        android:background="@drawable/nav_bar_bg">

        <!-- 弹射 pill 指示器（位移动画挂这里，OvershootInterpolator 0.7） -->
        <View
            android:id="@+id/nav_pill"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/nav_pill_bg"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_tab_contacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/nav_label_contacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_contacts"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/nav_sub_contacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_contacts_sub"
                    android:textSize="10sp"
                    android:alpha="0.6" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_tab_chat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/nav_label_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_chat"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/nav_sub_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_chat_sub"
                    android:textSize="10sp"
                    android:alpha="0.6" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_tab_mine"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/nav_label_mine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_mine"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/nav_sub_mine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_mine_sub"
                    android:textSize="10sp"
                    android:alpha="0.6" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
