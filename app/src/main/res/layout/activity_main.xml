<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- 任务 4：网络变化横幅（动态广播接收器收到后显示 3 秒） -->
    <TextView
        android:id="@+id/tv_net_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:gravity="center"
        android:background="@color/md_secondary_container"
        android:textColor="@color/md_on_secondary_container"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_hello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_subtitle"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_contacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/contact_list_title" />

    <Button
        android:id="@+id/btn_chat"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_title"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_draft"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/draft_title"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_edit_nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_nickname_title"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_lab"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lab_title"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_about"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_title"
        android:layout_marginTop="8dp" />

</LinearLayout>
