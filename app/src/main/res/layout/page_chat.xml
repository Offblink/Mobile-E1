<?xml version="1.0" encoding="utf-8"?>
<!-- 班级群 tab：标题（含上传）+ 消息时间线（文本 + 文件卡片）+ 左下公告 FAB + 输入行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 标题行：标题 + 上传群文件（与桌面端客户端同一条 POST /api/file） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chat_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_upload"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/chat_upload" />

    </LinearLayout>

    <!-- 消息时间线 + 左下角公告 FAB（红点 = 有未读公告） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp" />

        <!--
          包一层并留 12dp padding：FAB 的投影画在自身 bounds 之外，而容器 wrap_content
          默认 clipChildren=true —— 不留空的话投影会被容器的矩形边界硬切，角上就是一块
          「没圆角的方阴影」。margin 4 + padding 12 = 与原来的 16dp 定位一致；
          12dp 覆盖 M3 FAB 默认 elevation 6dp（按压/悬停再加 translationZ 也有余量）。
        -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:padding="12dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/notice_fab_desc"
                android:src="@drawable/ic_notice"
                app:backgroundTint="?attr/colorPrimaryContainer"
                app:tint="?attr/colorOnPrimaryContainer" />

            <View
                android:id="@+id/dot_notice"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_dot_red"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- 输入行：底部留出胶囊导航的高度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="96dp"
        android:background="?attr/colorSurfaceContainer">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/chat_input_hint"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_send" />
    </LinearLayout>

</LinearLayout>
