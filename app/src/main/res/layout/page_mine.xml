<?xml version="1.0" encoding="utf-8"?>
<!-- 我的 tab：编辑昵称 / 工具箱 / 下载中心 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:paddingBottom="104dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_mine"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_edit_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_nickname_title" />

        <Button
            android:id="@+id/btn_tools"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tools_title"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_download"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_title"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
