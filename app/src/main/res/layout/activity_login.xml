<?xml version="1.0" encoding="utf-8"?>
<!--
   登录页：四大布局 + 七控件
  • ConstraintLayout —— 根布局（扁平化，替代多层嵌套）
  • LinearLayout     —— horizontal + layout_weight：学号/姓名 两等分输入行
  • RelativeLayout   —— 底部按钮区：登录居左、注册 alignParentEnd 居右
  • FrameLayout      —— 头像角标叠加（最内层元素盖在上层）
  • 七控件：TextView / EditText / Button / ImageView / RadioButton / CheckBox / Switch
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- FrameLayout：头像 + 右下角在线角标叠加 -->
    <FrameLayout
        android:id="@+id/fl_avatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/login_avatar_desc"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@color/md_primary_container" />

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/dot_online" />
    </FrameLayout>

    <!-- TextView：页面标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/login_title"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/fl_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LinearLayout：horizontal + weight 两等分（weight 演示位） -->
    <LinearLayout
        android:id="@+id/ll_inputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <EditText
            android:id="@+id/et_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/login_username_hint"
            android:inputType="text"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/login_password_hint"
            android:inputType="textPassword" />
    </LinearLayout>

    <!-- RadioButton：身份单选（RadioGroup 包一组） -->
    <RadioGroup
        android:id="@+id/rg_role"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/ll_inputs">

        <RadioButton
            android:id="@+id/rb_student"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_role_student"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_teacher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="@string/login_role_teacher" />
    </RadioGroup>

    <!-- CheckBox：同意协议（登录前置校验项） -->
    <CheckBox
        android:id="@+id/cb_agree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/login_agree"
        app:layout_constraintTop_toBottomOf="@id/rg_role" />

    <!-- Switch：记住密码 -->
    <Switch
        android:id="@+id/sw_remember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/login_remember"
        app:layout_constraintTop_toBottomOf="@id/cb_agree" />

    <!-- RelativeLayout：登录居左、注册 alignParentEnd 居右 -->
    <RelativeLayout
        android:id="@+id/rl_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/sw_remember">

        <Button
            android:id="@+id/btn_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:minWidth="120dp"
            android:text="@string/login_btn" />

        <Button
            android:id="@+id/btn_register"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="@string/login_register_btn" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
